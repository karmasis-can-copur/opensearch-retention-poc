# Copy this file to .env and set your local file path.
# The sample file keeps the PoC self-contained; replace with a real Dataskope NDJSON file for volume tests.
HOST_EVENTS_FILE=./samples/dataskope-events.sample.ndjson
HOST_REJECTED_EVENTS_DIR=./artifacts/rejected-events

# MinIO is used as the S3-compatible snapshot repository for searchable snapshots.
# On docker-os-cls this should point to the separate /data disk.
MINIO_DATA_DIR=/data/minio
MINIO_ROOT_USER=dataskope
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=dataskope-opensearch-snapshots

# ISM reconciler attaches policies to backdated daily indexes independently from the writer.
ISM_RECONCILE_POLICY_ID=events-hot-cold-snapshot-10-10
ISM_RECONCILE_INTERVAL_SECONDS=60
