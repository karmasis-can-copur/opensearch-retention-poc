{
  "index_patterns": [
    "events_*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "index.number_of_shards": 3,
      "index.number_of_replicas": 0,
      "index.refresh_interval": "1s",
      "index.routing.allocation.require.temp": "hot",
      "index.plugins.index_state_management.rollover_skip": true
    },
    "mappings": {
      "dynamic": true,
      "numeric_detection": false,
      "date_detection": false,
      "dynamic_templates": [
        {
          "strings": {
            "match": "*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "norms": false,
              "fields": {
                "raw": {
                  "type": "keyword",
                  "ignore_above": 250
                }
              }
            }
          }
        }
      ],
      "properties": {
        "TimeCreated": {
          "type": "date"
        },
        "TimeInserted": {
          "type": "date"
        },
        "EventID": {
          "type": "float"
        },
        "Level": {
          "type": "float"
        },
        "Severity": {
          "type": "float"
        },
        "DataLabel": {
          "type": "float"
        }
      }
    }
  },
  "_meta": {
    "source": "Converted from elasticsearch-template-for-dataskope.txt legacy _template/_default_ mapping. _all is omitted because it is not supported in OpenSearch 2.x."
  }
}
