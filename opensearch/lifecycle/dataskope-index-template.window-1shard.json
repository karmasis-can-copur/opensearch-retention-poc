{
  "index_patterns": [
    "events_*"
  ],
  "priority": 210,
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.codec": "best_compression",
      "index.mapping.total_fields.limit": 5000,
      "index.refresh_interval": "5s",
      "index.routing.allocation.require.temp": "hot",
      "index.plugins.index_state_management.rollover_skip": true
    },
    "mappings": {
      "dynamic": true,
      "numeric_detection": false,
      "date_detection": false,
      "dynamic_templates": [
        {
          "strings": {
            "match": "*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "norms": false,
              "fields": {
                "raw": {
                  "type": "keyword",
                  "ignore_above": 250
                }
              }
            }
          }
        }
      ],
      "properties": {
        "TimeCreated": {
          "type": "date"
        },
        "TimeInserted": {
          "type": "date"
        },
        "EventID": {
          "type": "float"
        },
        "Level": {
          "type": "float"
        },
        "Severity": {
          "type": "float"
        },
        "DataLabel": {
          "type": "float"
        }
      }
    }
  },
  "_meta": {
    "source": "Real-window PoC template. Same Dataskope mapping as loadtest template, but 1 primary shard for small 9-day comparison runs."
  }
}
