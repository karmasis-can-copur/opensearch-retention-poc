{
  "policy": {
    "description": "Dataskope real-data retention PoC: 10d hot, 10d cold data tier, then searchable snapshot through S3/MinIO repository.",
    "schema_version": 7,
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "index_priority": {
              "priority": 100
            }
          }
        ],
        "transitions": [
          {
            "state_name": "snapshot_ready",
            "conditions": {
              "min_index_age": "20d"
            }
          },
          {
            "state_name": "cold",
            "conditions": {
              "min_index_age": "10d"
            }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "read_only": {}
          },
          {
            "force_merge": {
              "max_num_segments": 1
            },
            "retry": {
              "count": 3,
              "delay": "1m"
            }
          },
          {
            "allocation": {
              "require": {
                "temp": "cold"
              }
            },
            "retry": {
              "count": 5,
              "delay": "1m"
            }
          },
          {
            "index_priority": {
              "priority": 50
            }
          }
        ],
        "transitions": [
          {
            "state_name": "snapshot_ready",
            "conditions": {
              "min_index_age": "20d"
            }
          }
        ]
      },
      {
        "name": "snapshot_ready",
        "actions": [
          {
            "read_only": {}
          },
          {
            "force_merge": {
              "max_num_segments": 1
            },
            "retry": {
              "count": 3,
              "delay": "1m"
            }
          },
          {
            "allocation": {
              "require": {
                "temp": "frozen"
              }
            },
            "retry": {
              "count": 5,
              "delay": "1m"
            }
          },
          {
            "snapshot": {
              "repository": "dataskope_lifecycle_repo",
              "snapshot": "{{ctx.index}}"
            },
            "retry": {
              "count": 3,
              "delay": "1m"
            }
          },
          {
            "convert_index_to_remote": {
              "repository": "dataskope_lifecycle_repo",
              "snapshot": "{{ctx.index}}",
              "rename_pattern": "remote_$1"
            },
            "retry": {
              "count": 3,
              "delay": "1m"
            }
          },
          {
            "delete": {},
            "retry": {
              "count": 3,
              "delay": "1m"
            }
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "events_*"
        ],
        "priority": 300
      }
    ]
  }
}
