{
  "policy": {
    "description": "Dataskope daily-index lifecycle: hot write/search, cold read-only search, then snapshot-ready. Backfilled old-date indexes are promoted with scripts/promote-events-by-date.ps1 because ISM min_index_age uses index creation time.",
    "schema_version": 1,
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "index_priority": {
              "priority": 100
            }
          }
        ],
        "transitions": [
          {
            "state_name": "cold",
            "conditions": {
              "min_index_age": "2d"
            }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "read_only": {}
          },
          {
            "force_merge": {
              "max_num_segments": 1
            },
            "retry": {
              "count": 3,
              "delay": "1m"
            }
          },
          {
            "allocation": {
              "require": {
                "temp": "cold"
              }
            },
            "retry": {
              "count": 5,
              "delay": "1m"
            }
          },
          {
            "index_priority": {
              "priority": 50
            }
          }
        ],
        "transitions": [
          {
            "state_name": "snapshot_ready",
            "conditions": {
              "min_index_age": "30d"
            }
          }
        ]
      },
      {
        "name": "snapshot_ready",
        "actions": [
          {
            "snapshot": {
              "repository": "dataskope_lifecycle_repo",
              "snapshot": "{{ctx.index}}"
            },
            "retry": {
              "count": 3,
              "delay": "1m"
            }
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": {
      "index_patterns": [
        "events_*"
      ],
      "priority": 100
    }
  }
}
